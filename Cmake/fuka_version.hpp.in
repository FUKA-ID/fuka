#pragma once
#include <string>
#include <sstream>
#include <tuple>

namespace Kadath::FUKA {
#define __FUKA_VERSION__ @PROJECT_VERSION@
static constexpr const char* VERSION      = "v@PROJECT_VERSION@";
static constexpr const char* GIT_HASH     = "@GIT_HASH@";
static constexpr const char* GIT_DESCRIBE = "@GIT_DESCRIBE@";
static constexpr const char* BUILD_DATE   = "@BUILD_DATE@";
static constexpr bool        GIT_DIRTY    = @GIT_DIRTY@;

static inline std::tuple<int, int, int> parse_version(const std::string& v) {
    int major = 0, minor = 0, patch = 0;
    char dot;

    std::string s = v;
    if (!s.empty() && (s[0] == 'v' || s[0] == 'V')) {
        s.erase(0, 1);
    }

    std::istringstream iss(s);
    iss >> major >> dot >> minor;
    if (iss >> dot >> patch) {
        // patch present
    }
    return {major, minor, patch};
}

static inline bool is_older_than(const std::string& v, const std::string& target) {
    return parse_version(v) < parse_version(target);
}

static inline std::string fuka_version() {
    return VERSION;
}

static inline std::string git_hash() {
    return GIT_HASH;
}

static inline std::string git_describe() {
    return GIT_DESCRIBE;
}

static inline std::string build_date() {
    return BUILD_DATE;
}

static inline bool git_dirty() {
    return GIT_DIRTY;
}
}